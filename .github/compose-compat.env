# What a server of the newest release has in its .env, for the CI job
# "Compose files of the newest release". Fake values only: this file is
# public, and the sign-in provider need not exist for Logbook to start.
POSTGRES_PASSWORD=compat-only-password
DATABASE_URL=postgres://logbook:compat-only-password@postgres:5432/logbook
LOGBOOK_BASE_URL=https://logbook.example.invalid
BETTER_AUTH_SECRET=compat-only-not-a-secret-compat-only-not-a-secret
OIDC_ISSUER=https://sso.example.invalid/realms/logbook
OIDC_CLIENT_ID=logbook
OIDC_CLIENT_SECRET=compat-only
INITIAL_ADMIN_EMAILS=admin@example.invalid
# Docker Compose 2.38 (GitHub's runner) reads the old names in the fallbacks
# ${LOGBOOK_VERSION:-${LOGBUCH_VERSION:?...}} and
# ${LOGBOOK_BASE_URL:-${LOGBUCH_BASE_URL:?...}} even when the new ones are set.
# The compose files on main have no :? inside the fallbacks: remove these two
# once a release after 0.3.3 has them on stable.
LOGBUCH_VERSION=0.0.0-compat
LOGBUCH_BASE_URL=https://logbook.example.invalid
